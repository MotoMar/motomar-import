parameters:
    level: 9

    # No baseline. There was one, with 240 entries; it is gone because the
    # errors are. Adding it back would mean deciding that some of this code is
    # allowed to lie about its types again.
    paths:
        - src
        - bin
        - tests

    stubFiles:
        - phpstan/medoo.stub

    excludePaths:
        analyse:
            # Throwaway scripts kept in the webroot for poking at a broken
            # import. Not part of the application and never will be.
            - public/debug.php
            - public/debug-session.php
            - public/check-syntax.php
            - public/force-reset.php
